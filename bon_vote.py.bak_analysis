"""
bon_vote.py — 下游 BoN 评测 (按答案分组的 PRM 加权投票, plan×step 链分)

独立脚本, 不复用 eval_bon.py。只为你的生成式双分数 PRM (ours) 设计。

== 任务 ==
  每题有一个候选池 (该题所有 plan_idx×exec_idx 的链)。对每条链:
    1) PRM 逐步打 <step_score>, 聚合成 step_agg (默认 mean);
       逐步打 <plan_score>, 取该链所有步的均值作为 plan_score;
    2) 链分 final = plan_score × step_agg  (默认 multiply, plan 当把关);
  按"最终答案"把候选分组, 组内 final 求和, 选总分最高的答案组 -> 该题预测答案,
  和 gold 比对 (用轨迹里已存的 correct) 得 BoN 命中。

  同时输出基线: pass@1(随机下限) / oracle(上限) / majority(纯数票) / PRM单独挑分最高。

== 截断/无答案链 ==
  保留在候选池里, 但 answer 为 None 的链不参与答案分组投票 (归 "__no_answer__",
  统计可见, 不被选中)。和生成阶段口径一致, 不丢链。

== 多卡数据并行 ==
  按 prob_idx % num_shards 切题, 每卡一进程独立加载一份模型 (--tp 1) 各跑各的,
  存分片; 最后 --mode merge 合并出报告。见配套 run_bon_vote.sh。

用法:
  # 单卡
  python bon_vote.py --traj cand.jsonl --problems test.jsonl --prm <PRM> --score_scheme v6
  # 多卡: 见 run_bon_vote.sh (每卡一个 shard, 跑完 merge)
  # 合并
  python bon_vote.py --mode merge --traj cand.jsonl --shard_glob 'runs/bon/sh*.json' --out runs/bon/report.json
"""
import os
os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")
import argparse, json, re, glob
from collections import defaultdict, Counter

# ---------------- 双分数解析 (与训练输出格式一致) ----------------
PLAN_RE = re.compile(r"<plan_score>\s*([0-9]*\.?[0-9]+)\s*</plan_score>")
STEP_RE = re.compile(r"<step_score>\s*([0-9]*\.?[0-9]+)\s*</step_score>")

def _norm01(v):
    if v is None: return None
    return v if 0.0 <= v <= 1.0 else None

def parse_dual(text):
    t = text or ""
    p = s = None
    m = PLAN_RE.search(t)
    if m:
        try: p = _norm01(float(m.group(1)))
        except ValueError: pass
    m = STEP_RE.search(t)
    if m:
        try: s = _norm01(float(m.group(1)))
        except ValueError: pass
    return p, s

# ---------------- 指令模板 (三种分类方案, 必须与 checkpoint 对齐) ----------------
PREAMBLE = ("You are given a PLAN (a multi-stage solution strategy) and an EXECUTION "
            "HISTORY ending in a CURRENT STEP. Output exactly two scores and nothing else:\n")
PLAN_3 = ("plan_score: how reliable is the PLAN itself (independent of how well any "
          "single execution carries it out)? Use exactly one of: 0.0 (this plan rarely "
          "leads to a correct answer, or frequently fails to even produce a complete "
          "result), 0.5 (mixed or inconsistent results across attempts), or 1.0 (this "
          "plan reliably leads to a correct answer).")
PLAN_2 = ("plan_score: how reliable is the PLAN itself (independent of how well any "
          "single execution carries it out)? Use exactly one of: 0.0 (this plan rarely "
          "leads to a correct answer, or frequently fails to even produce a complete "
          "result) or 1.0 (this plan reliably leads to a correct answer).")
STEP_3 = ("step_score: is the CURRENT STEP itself correct and trustworthy? Use exactly "
          "one of: 0.0 (no — wrong, deviates from the plan, or does no real work), 0.5 "
          "(cannot be independently determined), or 1.0 (yes — well-supported).")
STEP_2 = ("step_score: is the CURRENT STEP itself correct and trustworthy? Use exactly "
          "one of: 0.0 (no — wrong, deviates from the plan, or does no real work) or "
          "1.0 (yes — well-supported).")
SUFFIX = ("\nOutput ONLY the following two tags, in this exact order, with no other text:\n"
          "<plan_score>X.X</plan_score>\n<step_score>X.X</step_score>")

def _instr(plan_part, step_part):
    return PREAMBLE + plan_part + "\n" + step_part + SUFFIX

INSTRUCTION_VARIANTS = {
    "v6":     _instr(PLAN_3, STEP_3),
    "step01": _instr(PLAN_3, STEP_2),
    "full01": _instr(PLAN_2, STEP_2),
}

def build_input(problem, plan, steps_so_far, cur_step):
    plan_str = "\n".join(f"  {p['id']} ({p.get('action','?')}): {p['desc']}" for p in plan)
    hist = ""
    for j, s in enumerate(steps_so_far):
        hist += (f"\n[Step {j+1}] claims {s['claimed']}\n"
                 f"code:\n{s['code']}\noutput:\n{s['exec']}\n")
    cur = (f"claims {cur_step['claimed']}\ncode:\n{cur_step['code']}\noutput:\n{cur_step['exec']}\n")
    return (f"Problem:\n{problem}\n\n=== PLAN ===\n{plan_str}\n\n"
            f"=== EXECUTION HISTORY ===\n{hist if hist else '(none)'}\n"
            f"=== CURRENT STEP ===\n{cur}\nOutput plan_score and step_score for the above.")

# ---------------- 聚合 + 组合 ----------------
def step_aggregate(step_scores, how="mean"):
    xs = [s if s is not None else 0.5 for s in step_scores]
    if not xs:
        return None                 # 空链(截断): 没有步, step_agg 无意义
    if how == "min":  return min(xs)
    if how == "last": return xs[-1]
    return sum(xs) / len(xs)         # mean (默认)

def combine(step_agg, plan_score, mode="multiply", weight=0.3):
    if step_agg is None:
        return 0.0                   # 空链直接 0 分 (不会被选中)
    if mode == "none" or plan_score is None:
        return step_agg
    if mode == "multiply":
        return step_agg * plan_score
    if mode == "weighted":
        return (1 - weight) * step_agg + weight * plan_score
    raise ValueError(mode)

# ---------------- 打分: ours (生成式双分数, vLLM 批量) ----------------
def score_ours(by_prob, problems, args):
    from vllm import LLM, SamplingParams
    from transformers import AutoTokenizer
    tok = AutoTokenizer.from_pretrained(args.prm, trust_remote_code=True)
    llm = LLM(model=args.prm, tensor_parallel_size=args.tp,
              max_model_len=args.max_model_len, gpu_memory_utilization=0.90,
              trust_remote_code=True)
    instruction = INSTRUCTION_VARIANTS[args.score_scheme]

    def chat(inp):
        return tok.apply_chat_template(
            [{"role": "user", "content": instruction + "\n\n" + inp}],
            tokenize=False, add_generation_prompt=True)

    prompts, index = [], []
    budget = args.max_model_len - args.max_gen - 16
    n_skip_long = 0
    for prob_idx, cand in by_prob.items():
        ptext = problems[prob_idx]["problem"] if problems else cand[0]["plan"][0]["desc"] if cand[0]["plan"] else ""
        for tpos, t in enumerate(cand):
            for i, s in enumerate(t["steps"]):       # 空链 steps=[] -> 不产生 prompt
                p = chat(build_input(ptext, t["plan"], t["steps"][:i], s))
                if len(tok(p)["input_ids"]) > budget:
                    n_skip_long += 1
                    continue
                prompts.append(p); index.append((prob_idx, tpos, i))

    sp = SamplingParams(temperature=0.0, max_tokens=args.max_gen,
                        repetition_penalty=args.repetition_penalty)
    tag = f"[shard {args.shard_id}] " if args.num_shards > 1 else ""
    print(f"{tag}scoring {len(prompts)} steps (skip_long={n_skip_long})...", flush=True)
    outs = llm.generate(prompts, sp)

    step_score = defaultdict(dict)                   # (p,tpos) -> {i: step_sc}
    plan_acc = defaultdict(list)                     # (p,tpos) -> [plan_sc,...]
    pf_step = pf_plan = 0
    for (p, tpos, i), o in zip(index, outs):
        pl, st = parse_dual(o.outputs[0].text)
        step_score[(p, tpos)][i] = st
        if st is None: pf_step += 1
        if pl is not None: plan_acc[(p, tpos)].append(pl)
        else: pf_plan += 1
    plan_score = {k: sum(v) / len(v) for k, v in plan_acc.items()}   # 每链 plan = 各步均值
    print(f"{tag}parse_fail step={pf_step} plan={pf_plan}", flush=True)
    return step_score, plan_score, pf_step

# ---------------- 打分: scalar (打分头 PRM, 如 Qwen2.5-Math-PRM) ----------------
# 外部 PRM 没有 plan_score, 返回空 plan_score -> chain_final 自动走纯 step(mean)。
def score_scalar(by_prob, problems, args):
    import torch
    from transformers import AutoModel, AutoTokenizer
    tok = AutoTokenizer.from_pretrained(args.prm, trust_remote_code=True)
    model = AutoModel.from_pretrained(args.prm, trust_remote_code=True,
                                      torch_dtype="auto", device_map="auto").eval()
    SEP = args.step_sep
    sep_id = tok.encode(SEP)[-1] if SEP else None

    def _scores(problem, steps):
        sys = "Please reason step by step, and put your final answer within \\boxed{}."
        chunks = [f"[{s['claimed']}] {s['code']}\n{s['exec']}" for s in steps]
        convo = [{"role": "system", "content": sys},
                 {"role": "user", "content": problem},
                 {"role": "assistant", "content": SEP.join(chunks) + SEP}]
        ids = tok.apply_chat_template(convo, tokenize=True, return_tensors="pt").to(model.device)
        with torch.no_grad():
            logits = model(ids).logits
        probs = torch.softmax(logits, dim=-1)[0]
        pos = (ids[0] == sep_id).nonzero(as_tuple=True)[0]
        return [probs[p, 1].item() if probs.shape[-1] >= 2 else probs[p].max().item() for p in pos]

    step_score = defaultdict(dict); pf = 0
    tag = f"[shard {args.shard_id}] " if args.num_shards > 1 else ""
    done = 0; total = sum(len(v) for v in by_prob.values())
    for prob_idx, cand in by_prob.items():
        ptext = problems[prob_idx]["problem"] if problems else (cand[0]["plan"][0]["desc"] if cand[0]["plan"] else "")
        for tpos, t in enumerate(cand):
            try:
                scs = _scores(ptext, t["steps"]) if t["steps"] else []
            except Exception:
                scs = []; pf += 1
            for i in range(len(t["steps"])):
                step_score[(prob_idx, tpos)][i] = scs[i] if i < len(scs) else None
            done += 1
        if done % 100 == 0: print(f"{tag}[scalar] {done}/{total}", flush=True)
    return step_score, {}, pf            # plan_score 空 -> 纯 step

# ---------------- 打分: skywork ----------------
def score_skywork(by_prob, problems, args):
    import torch
    from transformers import AutoTokenizer
    from model_utils.prm_model import PRM_MODEL
    from model_utils.io_utils import prepare_input, derive_step_rewards
    tok = AutoTokenizer.from_pretrained(args.prm, trust_remote_code=True)
    model = PRM_MODEL.from_pretrained(args.prm, device_map="auto",
                                      torch_dtype=torch.bfloat16).eval()

    def _scores(problem, steps):
        response = "\n\n".join(f"[{s['claimed']}] {s['code']}\n{s['exec']}" for s in steps)
        ids, mask, reward_idxs = prepare_input(problem, response, tokenizer=tok, step_token="\n\n")
        # ids = torch.tensor([ids]).to(model.device)
        device = next(model.parameters()).device
        ids = torch.tensor([ids]).to(device)
        with torch.no_grad():
            _, _, rewards = model(input_ids=ids, attention_mask=torch.ones_like(ids), return_probs=True)
        rf_tensor = torch.tensor(reward_idxs).unsqueeze(0).to(rewards.device)
        return derive_step_rewards(rewards, rf_tensor)[0]

    step_score = defaultdict(dict); pf = 0
    tag = f"[shard {args.shard_id}] " if args.num_shards > 1 else ""
    done = 0; total = sum(len(v) for v in by_prob.values())
    for prob_idx, cand in by_prob.items():
        ptext = problems[prob_idx]["problem"] if problems else (cand[0]["plan"][0]["desc"] if cand[0]["plan"] else "")
        for tpos, t in enumerate(cand):
            try:
                scs = _scores(ptext, t["steps"]) if t["steps"] else []
            except Exception:
                scs = []; pf += 1
            for i in range(len(t["steps"])):
                step_score[(prob_idx, tpos)][i] = scs[i] if i < len(scs) else None
            done += 1
        if done % 100 == 0: print(f"{tag}[skywork] {done}/{total}", flush=True)
    return step_score, {}, pf            # plan_score 空 -> 纯 step

SCORERS = {"ours": score_ours, "scalar": score_scalar, "skywork": score_skywork}

# ---------------- BoN 指标 ----------------
def chain_final(by_prob, step_score, plan_score, mode, weight, how):
    """{prob_idx: [(final, answer, correct_bool), ...]}"""
    out = {}
    for prob_idx, cand in by_prob.items():
        lst = []
        for tpos, t in enumerate(cand):
            ss = step_score.get((prob_idx, tpos), {})
            seq = [ss.get(i) for i in range(len(t["steps"]))]
            agg = step_aggregate(seq, how)
            psc = plan_score.get((prob_idx, tpos))
            final = combine(agg, psc, mode, weight)
            lst.append((final, t.get("answer"), bool(t.get("correct"))))
        out[prob_idx] = lst
    return out

def evaluate(by_prob, cf):
    n = len(by_prob)
    hit_vote = hit_top1 = hit_major = 0
    pass1 = oracle = 0.0
    for prob_idx, cand in by_prob.items():
        rows = cf[prob_idx]
        N = len(rows)
        corrects = [r[2] for r in rows]
        nc = sum(corrects)
        pass1 += nc / N
        oracle += 1 if nc > 0 else 0

        # --- PRM 加权投票: 按答案分组, 组内 final 求和, 选总分最高组 ---
        groups = defaultdict(float); rep = {}
        for final, ans, corr in rows:
            if ans is None:                     # 截断/无答案: 不投票, 但保留在池中
                continue
            groups[ans] += final
            rep.setdefault(ans, corr)
        if groups:
            win = max(groups, key=groups.get)
            hit_vote += int(rep[win])

        # --- PRM 单独挑分最高的单条 ---
        best = max(rows, key=lambda r: r[0])
        hit_top1 += int(best[2])

        # --- majority: 纯数票, 选答案出现次数最多的组 ---
        votes = Counter(r[1] for r in rows if r[1] is not None)
        if votes:
            mwin = votes.most_common(1)[0][0]
            # 该答案任意一条的对错
            mcorr = next(r[2] for r in rows if r[1] == mwin)
            hit_major += int(mcorr)

    return {
        "n_problems": n,
        "pass@1": round(pass1 / n, 4),
        "oracle": round(oracle / n, 4),
        "prm_weighted_vote": round(hit_vote / n, 4),
        "prm_top1": round(hit_top1 / n, 4),
        "majority": round(hit_major / n, 4),
    }

# ---------------- 分片存/取 ----------------
def save_shard(path, step_score, plan_score, covered, pf):
    json.dump({
        "parse_fail": pf, "covered": sorted(covered),
        "step_score": {f"{p}:{t}": {str(i): v for i, v in d.items()} for (p, t), d in step_score.items()},
        "plan_score": {f"{p}:{t}": v for (p, t), v in plan_score.items()},
    }, open(path, "w"))
    print(f"  shard saved -> {path} ({len(covered)} probs)", flush=True)

def load_shard(path):
    d = json.load(open(path))
    ss = defaultdict(dict)
    for k, dd in d["step_score"].items():
        p, t = map(int, k.split(":"))
        for i, v in dd.items(): ss[(p, t)][int(i)] = v
    ps = {tuple(map(int, k.split(":"))): v for k, v in d["plan_score"].items()}
    return ss, ps, d["covered"], d.get("parse_fail", 0)

# ---------------- main ----------------
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", default="ours",
                    choices=["ours", "scalar", "skywork", "majority", "merge"])
    ap.add_argument("--traj", required=True, help="候选轨迹 jsonl (每题多条候选)")
    ap.add_argument("--problems", default=None)
    ap.add_argument("--prm", default=None)
    ap.add_argument("--score_scheme", default="v6", choices=list(INSTRUCTION_VARIANTS))
    ap.add_argument("--combine", default="multiply", choices=["multiply", "weighted", "none"])
    ap.add_argument("--plan_weight", type=float, default=0.3)
    ap.add_argument("--how", default="mean", choices=["mean", "min", "last"])
    ap.add_argument("--step_sep", default="<extra_0>", help="scalar PRM 的步分隔 token")
    ap.add_argument("--tp", type=int, default=1)
    ap.add_argument("--max_model_len", type=int, default=8192)
    ap.add_argument("--max_gen", type=int, default=64)
    ap.add_argument("--repetition_penalty", type=float, default=1.0)
    ap.add_argument("--num_shards", type=int, default=1)
    ap.add_argument("--shard_id", type=int, default=0)
    ap.add_argument("--shard_glob", default=None)
    ap.add_argument("--out", default="runs/bon/report.json")
    args = ap.parse_args()

    trajs = [json.loads(l) for l in open(args.traj)]
    by_prob_full = defaultdict(list)
    for t in trajs:
        by_prob_full[t["prob_idx"]].append(t)

    problems = None
    if args.problems:
        problems = [json.loads(l) for l in open(args.problems)]
        for p in problems:                       # 字段归一化 (question/final_answer 等)
            if "problem" not in p:
                for k in ("question", "query", "prompt", "input"):
                    if k in p and p[k] is not None: p["problem"] = p[k]; break

    if os.path.dirname(args.out):
        os.makedirs(os.path.dirname(args.out), exist_ok=True)

    # ===== merge =====
    if args.mode == "merge":
        files = sorted(glob.glob(args.shard_glob))
        if not files: raise SystemExit(f"无分片: {args.shard_glob}")
        step_score = defaultdict(dict); plan_score = {}; pf = 0; covered = set()
        for f in files:
            ss, ps, cov, p = load_shard(f)
            for k, dd in ss.items(): step_score[k].update(dd)
            plan_score.update(ps); pf += p; covered.update(cov)
        miss = set(by_prob_full) - covered
        if miss: print(f"  ⚠ {len(miss)} 题未被任何分片覆盖")
        cf = chain_final(by_prob_full, step_score, plan_score, args.combine, args.plan_weight, args.how)
        rep = evaluate(by_prob_full, cf)
        rep.update({"combine": args.combine, "how": args.how, "parse_fail": pf, "n_shards": len(files)})
        json.dump(rep, open(args.out, "w"), ensure_ascii=False, indent=2)
        _print_report(rep)
        print(f"\n  saved -> {args.out}", flush=True)
        return

    # 外部 PRM 没有 plan, 强制纯 step (combine=none); majority 不打分
    if args.mode in ("scalar", "skywork") and args.combine != "none":
        print(f"⚠ 外部 PRM 无 plan_score, combine 强制 none (纯 step, mean 聚合)", flush=True)
        args.combine = "none"

    # ===== majority: 不需要 PRM, 直接投票 =====
    if args.mode == "majority":
        # 给每条链一个常数分, 这样"加权投票"退化成纯数票; 也直接看 majority 字段
        cf = {p: [(1.0, t.get("answer"), bool(t.get("correct"))) for t in cand]
              for p, cand in by_prob_full.items()}
        rep = evaluate(by_prob_full, cf)
        rep.update({"combine": "majority", "how": "-", "parse_fail": 0})
        json.dump(rep, open(args.out, "w"), ensure_ascii=False, indent=2)
        _print_report(rep)
        print(f"\n  saved -> {args.out}", flush=True)
        return

    # ===== score (ours/scalar/skywork) =====
    if not args.prm: ap.error(f"--mode {args.mode} 需要 --prm")
    if args.num_shards > 1:
        by_prob = {k: v for k, v in by_prob_full.items() if k % args.num_shards == args.shard_id}
        if not by_prob: raise SystemExit(f"shard {args.shard_id} 无题")
    else:
        by_prob = by_prob_full

    scorer = SCORERS[args.mode]
    step_score, plan_score, pf = scorer(by_prob, problems, args)

    if args.num_shards > 1:
        save_shard(f"{args.out}.shard{args.shard_id}.json", step_score, plan_score, list(by_prob), pf)
        return

    cf = chain_final(by_prob, step_score, plan_score, args.combine, args.plan_weight, args.how)
    rep = evaluate(by_prob, cf)
    rep.update({"mode": args.mode, "combine": args.combine, "how": args.how, "parse_fail": pf})
    json.dump(rep, open(args.out, "w"), ensure_ascii=False, indent=2)
    _print_report(rep)
    print(f"\n  saved -> {args.out}", flush=True)

def _print_report(rep):
    print("\n" + "=" * 56)
    print(f"  下游 BoN ({rep.get('combine')} / {rep.get('how')})  题数={rep['n_problems']}")
    print("=" * 56)
    print(f"  pass@1 (随机下限)        : {rep['pass@1']*100:.1f}%")
    print(f"  oracle (完美上限)        : {rep['oracle']*100:.1f}%")
    print(f"  majority (纯数票)        : {rep['majority']*100:.1f}%")
    print(f"  PRM 单独挑最高           : {rep['prm_top1']*100:.1f}%")
    print(f"  PRM 加权投票(按答案分组) : {rep['prm_weighted_vote']*100:.1f}%   <-- 主指标")
    print("=" * 56)

if __name__ == "__main__":
    main()
